NODE_ENV=development
PORT=3001
# Prefer DATABASE_URL. Do not configure DB_* alongside it in production.
DATABASE_URL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Used only when DATABASE_URL is absent (for local development fallback).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=mindscan
DATABASE_SSL=false
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
MINDSCAN_DEMO_MODE=false
PYTHON_EXECUTABLE=
MINDSCAN_MODEL_DIR=
MINDSCAN_MODEL_VERSION=
MINDSCAN_MODEL_NAME=logistic_regression
MINDSCAN_AUDIO_MODEL_DIR=
MINDSCAN_AUDIO_MODEL_VERSION=
MINDSCAN_AUDIO_MODEL_NAME=logistic_regression
MINDSCAN_AUDIO_MODEL_PYTHON=
