{
  "name": "mindscan-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\setup.ps1",
    "dev": "node scripts/dev.js",
    "db:ensure": "npm --prefix Backend run database:ensure",
    "db:migrate": "npm --prefix Backend run migrate",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix Backend test",
    "test:frontend": "npm --prefix Frontend test",
    "test:python": ".\\.venv\\Scripts\\python.exe -m unittest discover -s Backend\\ml -p test_*.py",
    "lint": "npm --prefix Frontend run lint",
    "build": "npm --prefix Frontend run build"
  }
}
